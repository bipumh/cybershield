# ─── Core ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=CyberShield
SECRET_KEY=CHANGE_ME_in_production_generate_a_random_64_byte_string
# Comma separated allowed origins (frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Timezone for scheduling / SLA
TIMEZONE=UTC

# ─── Database (switch to postgres without code changes) ────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./cybershield.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cybershield

# ─── Auth / JWT ────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440
MFA_ENABLED=false
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_AGE_DAYS=90
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW=60

# ─── Scanning safety (DEFAULTS, hard limits enforced in code) ──────────
SCAN_GLOBAL_RATE_LIMIT=20
SCAN_DEFAULT_TIMEOUT=15
SCAN_MAX_CONCURRENCY=10
SCAN_MAX_ACTIVE_SCANS=5
# Bypass proxy/disable TLS verification for lab testing ONLY
SCAN_ALLOW_INSECURE=false

# ─── Scheduling ────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true

# ─── AI Security Analyst (provider-independent LLM abstraction) ───────
AI_PROVIDER=off           # off | mocked | openai | anthropic | openai_compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200

# ─── SIEM / webhook integration (optional) ─────────────────────────────
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=

# ─── Admin bootstrap (used once on first startup) ───────────────────────
ADMIN_EMAIL=admin@cybershieldplatform.com
ADMIN_PASSWORD=ChangeThis!Now12345
