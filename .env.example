# Root env template for docker-compose deployments.
# Copy to .env and set real values (never commit .env).

POSTGRES_USER=cybershield
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cybershield
POSTGRES_HOST=db

ENVIRONMENT=production
SECRET_KEY=change-me-random-64-bytes
CORS_ORIGINS=http://localhost:8080

ADMIN_EMAIL=admin@cybershieldplatform.com
ADMIN_PASSWORD=ChangeThis!Now12345

AI_PROVIDER=off
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

SCAN_ALLOW_INSECURE=false
